{
  "name": "negotiation-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && tsc --noEmit",
    "start": "node server.js",
    "lint": "tsc --noEmit",
    "test:pricing": "tsx tests/pricing.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:pricing && npm run test:template && npm run test:e2e",
    "test:template": "tsx tests/template.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "docx": "^9.16.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}